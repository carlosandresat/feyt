---
// Breadcrumbs drawn as the neuron's path: from the soma (FEYT) through each ancestor to the
// current topic, which is the lit node at the end.
import type { Locale } from '../lib/domain';
import { localizedPath, topicPath, t } from '../lib/i18n';
import { topicTitle, type Topic } from '../lib/content';

interface Props {
  locale: Locale;
  ancestors: Topic[];
  current: string;
}
const { locale, ancestors, current } = Astro.props;
const _ = t(locale);
---

<nav aria-label={_('breadcrumbs.label')}>
  <ol>
    <li class="soma">
      <span class="node" aria-hidden="true"></span>
      <a href={localizedPath(locale, '/temas/')}>FEYT</a>
    </li>
    {ancestors.map((a) => (
      <li>
        <span class="segment" aria-hidden="true" />
        <span class="node" aria-hidden="true" />
        <a href={topicPath(locale, a.key)}>{topicTitle(a, locale)}</a>
      </li>
    ))}
    <li class="current" aria-current="page">
      <span class="segment" aria-hidden="true"></span>
      <span class="node" aria-hidden="true"></span>
      <span>{current}</span>
    </li>
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.4rem;
    padding: 0;
    margin: 0 0 1.5rem;
    list-style: none;
    font-size: var(--step--1);
    color: var(--muted);
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .segment {
    width: 1.1rem;
    height: 2px;
    margin-left: 0.45rem;
    background: var(--branch);
    opacity: 0.7;
  }
  .node {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 2px solid var(--branch);
    background: var(--bg);
  }
  .soma .node {
    width: 0.7rem;
    height: 0.7rem;
    border: 0;
    background: var(--brand);
    box-shadow: 0 0 0.6rem var(--glow);
  }
  .current {
    color: var(--text);
    font-weight: 600;
  }
  .current .node {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0.6rem var(--glow);
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
