---
import type { Locale, Status } from '../lib/domain';
import { t } from '../lib/i18n';

interface Props {
  status: Status;
  locale: Locale;
}
const { status, locale } = Astro.props;
---

<span class="badge" style={`--status: var(--status-${status})`}>
  <span class="dot" aria-hidden="true"></span>
  {t(locale)(`status.${status}`)}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem 0.15rem 0.45rem;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    color: var(--status);
    background: color-mix(in srgb, var(--status) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--status) 35%, transparent);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--status);
    box-shadow: 0 0 0.5rem light-dark(transparent, var(--status));
  }
</style>
