---
// A topic's history drawn as an axon: one vertical fiber with a synapse per update. Updates that
// changed the status light their synapse with the new status color.
import { render } from 'astro:content';
import type { Locale } from '../lib/domain';
import { formatDate, t } from '../lib/i18n';
import { pickLocale, type Update } from '../lib/content';
import StatusBadge from './StatusBadge.astro';
import DocumentList from './DocumentList.astro';

interface Props {
  updates: Update[];
  locale: Locale;
}
const { updates, locale } = Astro.props;
const _ = t(locale);

// `render()` turns each entry's Markdown into a <Content /> component.
const items = await Promise.all(
  updates.map(async (update) => {
    const { entry, missingTranslation } = pickLocale(update.es, update.en, locale);
    const { Content } = await render(entry);
    return { update, title: entry.data.title, missingTranslation, Content };
  }),
);
---

<section>
  <h2>{_('topic.timeline')}</h2>
  {items.length === 0 && <p class="muted">{_('topic.noUpdates')}</p>}
  <ol class="axon">
    {items.map(({ update, title, missingTranslation, Content }) => {
      const status = update.es.data.status;
      return (
        <li style={status ? `--status: var(--status-${status})` : undefined}>
          <span class:list={['synapse', { changed: status }]} aria-hidden="true" />
          <p class="meta">
            <time datetime={update.date.toISOString()}>{formatDate(update.date, locale)}</time>
            <span class="type">{_(`updateType.${update.es.data.type}`)}</span>
            {missingTranslation && (
              <span class="type" title={_('translation.missing')}>
                ES
              </span>
            )}
          </p>
          <h3>{title}</h3>
          {status && (
            <p class="status-change">
              {_('topic.statusChangedTo')} <StatusBadge status={status} locale={locale} />
            </p>
          )}
          <div class="body">
            <Content />
          </div>
          <DocumentList
            documents={update.es.data.documents}
            links={update.es.data.links}
            locale={locale}
            compact
          />
        </li>
      );
    })}
  </ol>
</section>

<style>
  .axon {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.75rem;
  }
  /* The fiber: fades out at the oldest end. */
  .axon::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--branch), transparent);
    box-shadow: 0 0 0.6rem var(--glow);
  }
  .axon > li {
    position: relative;
    padding-bottom: 2rem;
  }
  .synapse {
    position: absolute;
    left: -1.62rem;
    top: 0.3rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    border: 2px solid var(--branch);
    background: var(--bg);
  }
  .synapse.changed {
    border-color: var(--status);
    background: var(--status);
    box-shadow: 0 0 0.7rem light-dark(transparent, var(--status));
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .type {
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  h3 {
    margin: 0 0 0.4rem;
  }
  .status-change {
    margin: 0 0 0.5rem;
    font-size: var(--step--1);
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
