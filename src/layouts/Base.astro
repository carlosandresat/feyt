---
import { Font } from 'astro:assets';
import '../styles/global.css';
import type { Locale } from '../lib/domain';
import { localizedPath, switchLocale, t } from '../lib/i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Full-bleed pages (e.g. the home hero) manage their own width. */
  wide?: boolean;
}

const { locale, title, description, wide = false } = Astro.props;
const _ = t(locale);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const fullTitle = title ? `${title} | FEYT` : _('site.name');
const nav = [
  { href: localizedPath(locale, '/temas/'), label: _('nav.topics') },
  { href: localizedPath(locale, '/asambleas/'), label: _('nav.assemblies') },
  { href: localizedPath(locale, '/eventos/'), label: _('nav.events') },
  { href: localizedPath(locale, '/buscar/'), label: _('nav.search') },
];
const otherLocalePath = switchLocale(Astro.url.pathname, otherLocale);
const current = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? _('site.description')} />
    <link rel="alternate" hreflang={otherLocale} href={otherLocalePath} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <!--
      Runs before first paint so a saved theme never flashes the wrong colors.
      Without a saved choice, CSS follows the OS via `color-scheme: light dark`.
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale, '/')}>
        <span class="nucleus" aria-hidden="true"></span>FEYT
      </a>
      <nav aria-label={_('nav.label')}>
        {nav.map((item) => (
          <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="tools">
        <a href={otherLocalePath} hreflang={otherLocale} lang={otherLocale}>
          {_('nav.language')}
        </a>
        <button
          type="button"
          class="theme-toggle"
          data-label-light={_('theme.toLight')}
          data-label-dark={_('theme.toDark')}
          aria-label={_('theme.toggle')}
        >
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
          </svg>
        </button>
      </div>
    </header>
    <main class:list={{ page: !wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{_('footer.text')}</p>
    </footer>
  </body>
</html>

<script>
  // Toggles between light and dark and remembers the choice. The effective theme is whatever
  // `color-scheme` resolved to, so the first click always flips what the visitor is seeing.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
  const syncLabel = () => {
    button.ariaLabel = isDark() ? button.dataset.labelLight! : button.dataset.labelDark!;
  };
  button.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncLabel();
  });
  syncLabel();
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    padding: 0.9rem var(--gutter);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display-stack);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }
  .nucleus {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0.75rem var(--glow);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-right: auto;
  }
  nav a,
  .tools a {
    color: var(--text);
    text-decoration: none;
  }
  nav a:hover,
  .tools a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .icon-sun {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .icon-moon {
    fill: currentColor;
  }
  /* Show the icon of the theme you would switch TO. */
  .theme-toggle .icon-sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun {
      display: block;
    }
    :root:not([data-theme='light']) .icon-moon {
      display: none;
    }
  }
  :root[data-theme='dark'] .icon-sun {
    display: block;
  }
  :root[data-theme='dark'] .icon-moon {
    display: none;
  }
  .site-footer {
    padding: 2rem var(--gutter);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .site-footer p {
    margin: 0;
  }
</style>
