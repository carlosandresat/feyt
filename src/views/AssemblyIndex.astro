---
import Base from '../layouts/Base.astro';
import ScheduleList, { type ScheduleItem } from '../components/ScheduleList.astro';
import type { Locale } from '../lib/domain';
import { assemblyPath, t } from '../lib/i18n';
import { loadContent, past, pickLocale, upcoming, type Assembly } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const _ = t(locale);
const { assemblies } = await loadContent();

const toItem = (a: Assembly): ScheduleItem => {
  const { data } = pickLocale(a.es, a.en, locale).entry;
  return {
    href: assemblyPath(locale, a.id),
    title: data.title,
    summary: data.summary,
    date: a.date,
    statusLabel: _(`assemblyStatus.${a.es.data.status}`),
    cancelled: a.es.data.status === 'cancelled',
  };
};
const groups = [
  { heading: _('assemblies.upcoming'), items: upcoming(assemblies).map(toItem) },
  { heading: _('assemblies.past'), items: past(assemblies).map(toItem) },
].filter((g) => g.items.length > 0);
---

<Base locale={locale} title={_('assemblies.title')}>
  <h1>{_('assemblies.title')}</h1>
  {groups.map((group) => (
    <section>
      <h2>{group.heading}</h2>
      <ScheduleList items={group.items} locale={locale} />
    </section>
  ))}
</Base>
