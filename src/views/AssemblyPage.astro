---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import DocumentList from '../components/DocumentList.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import type { Locale } from '../lib/domain';
import { formatDate, localizedPath, topicPath, t } from '../lib/i18n';
import { getTopic, loadContent, pickLocale, topicTitle } from '../lib/content';

interface Props {
  id: string;
  locale: Locale;
}
const { id, locale } = Astro.props;
const _ = t(locale);

const assembly = (await loadContent()).assemblies.find((a) => a.id === id)!;
const { entry, missingTranslation } = pickLocale(assembly.es, assembly.en, locale);
const { Content } = await render(entry);
const data = assembly.es.data;
const topics = await Promise.all(assembly.topicKeys.map(getTopic));
---

<Base locale={locale} title={entry.data.title} description={entry.data.summary}>
  <p>
    <a href={localizedPath(locale, '/asambleas/')}>← {_('assemblies.title')}</a>
  </p>
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{entry.data.title}</h1>
    <p class="muted">
      {formatDate(assembly.date, locale, true)} · {_(`assemblyStatus.${data.status}`)}
      <br />
      {_('assembly.place')}: {data.place} · {_('assembly.format')}: {_(`format.${data.format}`)}
    </p>
    <p>{entry.data.summary}</p>
    {missingTranslation && <TranslationNotice locale={locale} />}
    <Content />

    {topics.length > 0 && (
      <section>
        <h2>{_('assembly.topics')}</h2>
        <ul>
          {topics.map((topic) => (
            <li>
              <a href={topicPath(locale, topic.key)}>{topicTitle(topic, locale)}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <DocumentList documents={data.documents} links={data.links} locale={locale} />
  </article>
</Base>
