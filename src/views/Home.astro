---
import Base from '../layouts/Base.astro';
import InterestPicker, {
  type InterestOption,
  type KitActivity,
  type KitIssue,
} from '../components/InterestPicker.astro';
import NeuronTree from '../components/NeuronTree.astro';
import ScheduleList from '../components/ScheduleList.astro';
import { STATUSES, type Locale } from '../lib/domain';
import type { UIKey } from '../i18n/ui';
import { assemblyPath, eventPath, formatDate, localizedPath, topicPath, t } from '../lib/i18n';
import {
  activityInterests,
  areaOf,
  ASSEMBLIES_INTEREST,
  VOLUNTEERING_INTEREST,
} from '../lib/interests';
import { descendants } from '../lib/tree';
import {
  getRecentUpdates,
  getTopic,
  loadContent,
  pickLocale,
  topicText,
  topicTitle,
  upcoming,
} from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const _ = t(locale);

const { tree, assemblies, events } = await loadContent();
const issues = tree.flatMap((root) => [root, ...descendants(root)]).filter((n) => n.status);
const legend = STATUSES.map((status) => ({
  status,
  count: issues.filter((i) => i.status === status).length,
}));
const plural = new Intl.PluralRules(locale);
const count = (n: number, one: UIKey, other: UIKey) =>
  _(plural.select(n) === 'one' ? one : other).replace('{n}', String(n));
const somaCaption = count(issues.length, 'count.issues.one', 'count.issues.other');

// "Tu frente": one option per area, plus the two ways to take part outside the tree.
const scheduledAssemblies = upcoming(assemblies);
const scheduledEvents = upcoming(events);
const upcomingLabel = (n: number) =>
  n === 0 ? _('interest.noDates') : count(n, 'count.upcoming.one', 'count.upcoming.other');
const interestOptions: InterestOption[] = [
  ...tree.map((area) => {
    const { title, interest } = topicText(area, locale).entry.data;
    const n = [area, ...descendants(area)].filter((d) => d.status).length;
    return {
      token: area.key,
      topicKey: area.key,
      group: title,
      label: interest ?? title,
      meta: count(n, 'count.issues.one', 'count.issues.other'),
    };
  }),
  {
    token: ASSEMBLIES_INTEREST,
    group: _('interest.group.participation'),
    label: _('interest.assemblies'),
    meta: upcomingLabel(scheduledAssemblies.length),
  },
  {
    token: VOLUNTEERING_INTEREST,
    group: _('interest.group.activities'),
    label: _('interest.volunteering'),
    meta: upcomingLabel(
      scheduledEvents.filter((e) => e.es.data.category === 'volunteering').length,
    ),
  },
];
const kitIssues: KitIssue[] = issues.map((topic) => ({
  interests: [areaOf(topic.key)],
  title: topicTitle(topic, locale),
  href: topicPath(locale, topic.key),
  status: topic.status!,
}));
const kitActivities: KitActivity[] = [
  ...scheduledAssemblies.map((a) => ({
    interests: activityInterests('assembly', a.topicKeys),
    title: pickLocale(a.es, a.en, locale).entry.data.title,
    href: assemblyPath(locale, a.id),
    date: a.date,
    place: a.es.data.place,
  })),
  ...scheduledEvents.map((e) => ({
    interests: activityInterests(e.es.data.category, e.topicKeys),
    title: pickLocale(e.es, e.en, locale).entry.data.title,
    href: eventPath(locale, e.id),
    date: e.date,
    place: e.es.data.place,
    registrationUrl: e.es.data.registrationUrl,
  })),
].sort((a, b) => a.date.getTime() - b.date.getTime());

const recent = await Promise.all(
  (await getRecentUpdates(5)).map(async (u) => ({ update: u, topic: await getTopic(u.key) })),
);
const nextAssemblies = scheduledAssemblies.map((a) => {
  const { data } = pickLocale(a.es, a.en, locale).entry;
  return {
    href: assemblyPath(locale, a.id),
    title: data.title,
    summary: data.summary,
    date: a.date,
    statusLabel: _(`assemblyStatus.${a.es.data.status}`),
  };
});
const nextEvents = scheduledEvents.slice(0, 3).map((e) => {
  const { data } = pickLocale(e.es, e.en, locale).entry;
  return {
    href: eventPath(locale, e.id),
    title: data.title,
    summary: data.summary,
    date: e.date,
    statusLabel: _(`eventStatus.${e.es.data.status}`),
    tag: _(`eventCategory.${e.es.data.category}`),
  };
});
---

<Base locale={locale} wide>
  <section class="hero">
    <div class="text">
      <h1>{_('home.title')}</h1>
      <p class="lead">{_('home.intro')}</p>
      <p class="actions">
        <a class="primary" href="#frente">
          {_('home.pickerCta')}
        </a>
        <a href={localizedPath(locale, '/buscar/')}>{_('home.searchCta')}</a>
        <a href={localizedPath(locale, '/temas/')}>{_('home.topicsCta')}</a>
      </p>
    </div>
    <div class="map">
      <ul class="legend" aria-label={_('home.legend')}>
        {legend.map(({ status, count }) => (
          <li style={`--status: var(--status-${status})`}>
            <span class="dot" aria-hidden="true" />
            {_(`status.${status}`)}
            <span class="count">{count}</span>
          </li>
        ))}
      </ul>
      <NeuronTree
        id="home"
        locale={locale}
        nodes={tree}
        soma={{ title: 'FEYT', caption: somaCaption }}
        maxDepth={3}
        animate
      />
    </div>
    <div class="picker">
      <InterestPicker
        locale={locale}
        neuron="home"
        options={interestOptions}
        issues={kitIssues}
        activities={kitActivities}
      />
    </div>
  </section>

  <div class="below">
    <section>
      <h2>{_('home.upcomingAssemblies')}</h2>
      {nextAssemblies.length === 0 && <p class="muted">{_('home.noAssemblies')}</p>}
      <ScheduleList items={nextAssemblies} locale={locale} />
    </section>
    <section>
      <h2>{_('home.upcomingEvents')}</h2>
      {nextEvents.length === 0 && <p class="muted">{_('home.noEvents')}</p>}
      <ScheduleList items={nextEvents} locale={locale} />
    </section>
    <section class="recent">
      <h2>{_('home.recentUpdates')}</h2>
      <ol>
        {recent.map(({ update, topic }) => (
          <li>
            <time class="muted" datetime={update.date.toISOString()}>
              {formatDate(update.date, locale)}
            </time>
            <a href={topicPath(locale, topic.key)}>{topicTitle(topic, locale)}</a>
            <span>{pickLocale(update.es, update.en, locale).entry.data.title}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style>
  /* Mobile: headline, legend + tree (on the first screen), then the interest picker.
     Desktop: text and picker on the left, so the branches you pick light up in the tree on the
     right while you choose. */
  .hero {
    display: grid;
    gap: 1.5rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 0.5rem + 4vw, 4.5rem) var(--gutter) 3rem;
  }
  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'text map'
        'picker map';
      gap: 2.5rem 3rem;
      align-items: start;
    }
    .text {
      grid-area: text;
    }
    .map {
      grid-area: map;
    }
    .picker {
      grid-area: picker;
    }
    /* The picker is right below the text here; the shortcut is only useful on mobile. */
    .actions .primary {
      display: none;
    }
  }
  h1 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.2rem);
    font-weight: 600;
    max-width: 16ch;
  }
  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 36ch;
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
  }
  .primary {
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 0 1.5rem light-dark(transparent, color-mix(in srgb, var(--glow) 45%, transparent));
  }
  .primary:hover {
    background: var(--accent);
  }
  .legend {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
  }
  .dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--status);
    box-shadow: 0 0 0.6rem light-dark(transparent, var(--status));
  }
  .count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .map {
    min-width: 0;
  }

  .below {
    display: grid;
    gap: 0 3rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 1rem var(--gutter) 5rem;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 52rem) {
    .below {
      grid-template-columns: 1fr 1fr;
    }
    .recent {
      grid-column: 1 / -1;
    }
  }
  .recent ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .recent li {
    display: grid;
    gap: 0.1rem;
  }
  @media (min-width: 52rem) {
    .recent li {
      grid-template-columns: 12rem 16rem 1fr;
      gap: 1.5rem;
    }
  }
  .recent time {
    font-size: var(--step--1);
  }
</style>
