---
import Base from '../layouts/Base.astro';
import type { Locale } from '../lib/domain';
import { t } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const _ = t(locale);
---

<Base locale={locale} title={_('search.title')}>
  <h1>{_('search.title')}</h1>
  <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />

  <!--
    Pagefind (Component UI) indexes the HTML generated AFTER `astro build`, so /pagefind/ doesn't
    exist in `pnpm dev`. That's why the script is loaded unprocessed (is:inline) and warns if missing.
    It searches the index matching <html lang> and translates its own UI automatically.
  -->
  <script
    is:inline
    type="module"
    src="/pagefind/pagefind-component-ui.js"
    onerror="document.getElementById('no-index').hidden = false"
  ></script>
  <p id="no-index" class="muted" hidden>
    {_('search.buildOnly')}
  </p>

  <div class="search">
    <pagefind-config instance="feyt"></pagefind-config>
    <pagefind-input instance="feyt"></pagefind-input>
    <div class="filters">
      <pagefind-filter-dropdown
        instance="feyt"
        filter="status"
        label={_('topic.status')}
      ></pagefind-filter-dropdown>
      <pagefind-filter-dropdown
        instance="feyt"
        filter="area"
        label={_('topic.area')}
      ></pagefind-filter-dropdown>
    </div>
    <pagefind-summary instance="feyt"></pagefind-summary>
    <pagefind-results instance="feyt"></pagefind-results>
  </div>
</Base>

<style is:global>
  /*
   * Pagefind's components reset `color-scheme` to `normal`, so a raw light-dark() token passed in
   * would always resolve to its light value inside them. Registering the color variables as
   * <color> makes the browser resolve light-dark() here, on .search (which has the right theme),
   * and hand Pagefind the final color.
   */
  @property --pf-background {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-hover {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-text {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-text-secondary {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-text-muted {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-border {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-border-focus {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-outline-focus {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-skeleton {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
  @property --pf-mark {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
</style>

<style>
  /* Pagefind sets its defaults on :root; redefining them here maps its UI onto our tokens. */
  .search {
    --pf-font: var(--font-body-stack);
    --pf-background: var(--surface);
    --pf-hover: var(--surface-2);
    --pf-text: var(--text);
    --pf-text-secondary: var(--muted);
    --pf-text-muted: var(--muted);
    --pf-border: var(--border);
    --pf-border-focus: var(--accent);
    --pf-outline-focus: var(--accent);
    --pf-border-radius: var(--radius-m);
    --pf-skeleton: var(--surface-2);
    --pf-mark: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
</style>
