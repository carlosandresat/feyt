---
import Base from '../layouts/Base.astro';
import NeuronTree from '../components/NeuronTree.astro';
import type { Locale } from '../lib/domain';
import { t } from '../lib/i18n';
import { loadContent } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const _ = t(locale);
const { tree } = await loadContent();
---

<Base locale={locale} title={_('topics.title')}>
  <h1>{_('topics.title')}</h1>
  <p class="muted">{_('topics.intro')}</p>
  <NeuronTree id="all" locale={locale} nodes={tree} soma={{ title: 'FEYT' }} filterable />
</Base>
