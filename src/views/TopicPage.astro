---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocumentList from '../components/DocumentList.astro';
import NeuronTree from '../components/NeuronTree.astro';
import ScheduleList, { type ScheduleItem } from '../components/ScheduleList.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Timeline from '../components/Timeline.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import { descendants } from '../lib/tree';
import type { Locale } from '../lib/domain';
import { assemblyPath, eventPath, formatDate, t } from '../lib/i18n';
import {
  getAncestors,
  getAssembliesForTopic,
  getEventsForTopic,
  getTopic,
  pickLocale,
  topicText,
  topicTitle,
} from '../lib/content';

interface Props {
  topicKey: string;
  locale: Locale;
}
const { topicKey, locale } = Astro.props;
const _ = t(locale);

const topic = await getTopic(topicKey);
const ancestors = await getAncestors(topicKey);
const { entry, missingTranslation } = topicText(topic, locale);
const { Content } = await render(entry);
const area = ancestors[0] ?? topic;

const subIssues = descendants(topic).filter((d) => d.status).length;
const plural = new Intl.PluralRules(locale);
const subCaption = _(
  plural.select(subIssues) === 'one' ? 'count.issues.one' : 'count.issues.other',
).replace('{n}', String(subIssues));

const related: ScheduleItem[] = [
  ...(await getAssembliesForTopic(topicKey)).map((a) => {
    const { data } = pickLocale(a.es, a.en, locale).entry;
    return {
      href: assemblyPath(locale, a.id),
      title: data.title,
      summary: data.summary,
      date: a.date,
      statusLabel: _(`assemblyStatus.${a.es.data.status}`),
      tag: _('updateType.assembly'),
    };
  }),
  ...(await getEventsForTopic(topicKey)).map((e) => {
    const { data } = pickLocale(e.es, e.en, locale).entry;
    return {
      href: eventPath(locale, e.id),
      title: data.title,
      summary: data.summary,
      date: e.date,
      statusLabel: _(`eventStatus.${e.es.data.status}`),
      tag: _(`eventCategory.${e.es.data.category}`),
    };
  }),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Base locale={locale} title={entry.data.title} description={entry.data.summary}>
  <Breadcrumbs locale={locale} ancestors={ancestors} current={entry.data.title} />

  <article data-pagefind-body>
    <header class="topic-header">
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <span hidden data-pagefind-filter="area">
        {topicTitle(area, locale)}
      </span>
      <p class="summary">{entry.data.summary}</p>
      {topic.status && (
        <dl class="facts">
          <div>
            <dt>{_('topic.status')}</dt>
            <dd data-pagefind-filter="status">
              <StatusBadge status={topic.status} locale={locale} />
            </dd>
          </div>
          <div>
            <dt>{_('topic.priority')}</dt>
            <dd>{_(`priority.${topic.data.priority}`)}</dd>
          </div>
          <div>
            <dt>{_('topic.updatedAt')}</dt>
            <dd>
              <time datetime={topic.updatedAt.toISOString()}>
                {formatDate(topic.updatedAt, locale)}
              </time>
            </dd>
          </div>
        </dl>
      )}
    </header>

    {missingTranslation && <TranslationNotice locale={locale} />}
    <div class="prose">
      <Content />
    </div>

    {topic.children.length > 0 && (
      <section>
        <h2>{_('topic.subtopics')}</h2>
        <NeuronTree
          id={`topic-${topic.key.replaceAll('/', '-')}`}
          locale={locale}
          nodes={topic.children}
          soma={{ title: entry.data.title, caption: subCaption }}
        />
      </section>
    )}

    {(topic.updates.length > 0 || topic.status) && (
      <Timeline updates={topic.updates} locale={locale} />
    )}

    <DocumentList documents={topic.data.documents} links={topic.data.links} locale={locale} />

    {related.length > 0 && (
      <section>
        <h2>{_('topic.relatedSchedule')}</h2>
        <ScheduleList items={related} locale={locale} />
      </section>
    )}
  </article>
</Base>

<style>
  .topic-header {
    margin-bottom: 1.5rem;
  }
  .summary {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 1.25rem 0 0;
  }
  dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }
</style>
