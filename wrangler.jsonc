// Cloudflare Workers with Static Assets: serves the dist/ folder as-is (phase 1, no server code).
// In phase 2, the @astrojs/cloudflare adapter will add a Worker (`main`) for dynamic routes.
{
  "name": "feyt",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
